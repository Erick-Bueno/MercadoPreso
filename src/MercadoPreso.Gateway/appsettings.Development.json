{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "mercadopreso-route": {
        "ClusterId": "mercadopreso-cluster",
        "Match": {
          "Path": "mercado-preso-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "mercadopreso-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5113"
          }
        }
      }
    }
  }
}
